theorem hasFDerivAt_correction {J : HermitianMat (r ⊕ s) ℂ} (lambda₀ lambda₁ : ℝ)
    {W : Blocks r s} (hT : (J+BetaDual.diagonal W).mat.PosDef) :
    HasFDerivAt (correction J lambda₀ lambda₁) (correctionGradient J lambda₀ lambda₁ W) W := by
