    intro z hz
    exact (continuousAt_kernelDeriv (hKPD z.1 hz.1) hz.2).continuousWithinAt
  obtain ⟨M,hM⟩ := ((isCompact_closedBall A (r/2)).prod isCompact_Icc).bddAbove_image hc.norm
