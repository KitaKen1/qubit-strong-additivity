theorem positiveInterior_of_minOn {J : HermitianMat (r ⊕ s) ℂ} {lambda₀ lambda₁ : ℝ}
    (hJ : J.mat.PosDef) {W : Blocks r s} (hW : W ∈ positiveCone)
