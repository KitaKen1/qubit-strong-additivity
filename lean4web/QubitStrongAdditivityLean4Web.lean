      (u • B) * (u • B) = (u * u) • (B * B) := by
    calc
      (u • B) * (u • B) = u • (B * (u • B)) := by
        exact Algebra.smul_mul_assoc (R := ℝ) (A := 𝓐) u B (u • B)
      _ = u • (u • (B * B)) := by
        simp [Algebra.mul_smul_comm]
      _ = (u * u) • (B * B) := by
        simp [smul_smul]
  rw [hAA', hAB', hBA', hBB']

