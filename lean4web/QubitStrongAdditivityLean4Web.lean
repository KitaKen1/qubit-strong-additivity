/-- The `MatrixMap.piProd` product of IsCompletelyPositive maps is also completely positive. -/
theorem piProd {Λi : ∀ i, MatrixMap (dI i) (dO i) R} (h₁ : ∀ i, (Λi i).IsCompletelyPositive) :
    IsCompletelyPositive (MatrixMap.piProd Λi) := by
