      (J+diagonal Z).conj (blockEmbedding R S)+(diagonal W).conj (1-(rangeProjection (blockEmbedding R S)).mat) := by
    rw [map_add,add_assoc]
  rw [hsum,psi_embedded_add_complement _ hT,objective_eq]
