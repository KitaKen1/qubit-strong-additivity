The perturbation need not commute with the base matrix. -/
theorem kmApply_logDeriv {A : Matrix n n ℂ} (hA : A.PosDef) (H : HermitianMat n ℂ) :
    kmApply A (BetaLog.logDeriv A H) = H.mat := by
  apply coordinates_injective hA.1
