  have hsum : ∑ i ∈ Finset.univ.erase i₀, q i ≤
      ∑ i ∈ Finset.univ.erase i₀, (Real.log (A.H.eigenvalues i+1)+1) := by
    exact Finset.sum_le_sum (fun i _ => scalar_increment_div_le (hA.eigenvalues_nonneg i) ht ht₁)
