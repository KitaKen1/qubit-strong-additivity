        exact Set.toFinite _;
      obtain ⟨δ_min, hδ_min_pos, hδ_min⟩ : ∃ δ_min > 0, ∀ y ∈ spectrum ℝ A₀.mat, δ_min ≤ δ y := by
        by_cases h_empty : spectrum ℝ A₀.mat = ∅;
        · exact ⟨ 1, zero_lt_one, by simp [ h_empty ] ⟩;
