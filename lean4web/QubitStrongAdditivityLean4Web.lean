def pinchLM : HermitianMat (r ⊕ s) ℂ →ₗ[ℝ] Blocks r s where
  toFun A := (pinchLeft A,pinchRight A)
  map_add' A B := by
    apply Prod.ext <;> apply HermitianMat.ext <;> rfl
  map_smul' c A := by
    apply Prod.ext <;> apply HermitianMat.ext <;> rfl

