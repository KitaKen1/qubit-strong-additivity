        (Vᴴ * C * V - B)
        (Vᴴ * C * K * V - B * k)
        (Vᴴ * C * K * V - B * k)
        (Vᴴ * C * K * K * V - k * B * k) := by
  have h11 : Vᴴ * (C - V * B * Vᴴ) * V = Vᴴ * C * V - B := by
    have hs : Vᴴ * (V * B * Vᴴ) * V = B := by
