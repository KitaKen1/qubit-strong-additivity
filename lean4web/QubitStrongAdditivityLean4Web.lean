private lemma square_convexity_diff_hCC_lean4web_15 (A B : 𝓐) (u : ℝ) :
    ((1 - u) • A + u • B) * ((1 - u) • A + u • B) =
      ((1 - u) * (1 - u)) • (A * A) + ((1 - u) * u) • (A * B)
        + (u * (1 - u)) • (B * A) + (u * u) • (B * B) := by
  have hexpand :
      ((1 - u) • A + u • B) * ((1 - u) • A + u • B) =
        ((1 - u) • A) * ((1 - u) • A)
          + ((1 - u) • A) * (u • B)
          + (u • B) * ((1 - u) • A)
          + (u • B) * (u • B) := by
    set X : 𝓐 := (1 - u) • A
    set Y : 𝓐 := u • B
    have hXY : (1 - u) • A + u • B = X + Y := by simp [X, Y]
    calc
      ((1 - u) • A + u • B) * ((1 - u) • A + u • B) = (X + Y) * (X + Y) := by
        simp [hXY]
      _ = X * (X + Y) + Y * (X + Y) := by
        simp [add_mul]
      _ = (X * X + X * Y) + (Y * X + Y * Y) := by
        simp [mul_add, add_assoc]
      _ = X * X + X * Y + Y * X + Y * Y := by
        abel
      _ = ((1 - u) • A) * ((1 - u) • A)
            + ((1 - u) • A) * (u • B)
            + (u • B) * ((1 - u) • A)
            + (u • B) * (u • B) := by
        simp [X, Y]
