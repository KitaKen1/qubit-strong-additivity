  rw [← (Matrix.isHermitian_mul_mul_conjTranspose U.val hM).coe_re_apply_self i]
  congr!
  · rw [mul_assoc, hU]
  all_goals
  ( rw [e.eq_symm_apply]
    symm; convert Classical.choose_eq _
    exact Fin.val_inj)

