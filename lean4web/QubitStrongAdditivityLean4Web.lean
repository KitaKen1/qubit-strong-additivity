    rw [Matrix.conjTranspose_mul, hK, Matrix.mul_sub, Matrix.sub_mul]
    have hs : Vᴴ * K * (V * B * Vᴴ) * (K * V) = k * B * k := by
      calc
        _ = (Vᴴ * K * V) * B * (Vᴴ * K * V) := by simp only [Matrix.mul_assoc]
