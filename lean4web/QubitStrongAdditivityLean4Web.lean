theorem logDeriv_apply {A : Matrix n n ℂ} (hA : A.PosDef) (H : HermitianMat n ℂ) :
    logDeriv A H = ∫ t in (0 : ℝ)..1, inverseSegment A t * H.mat * inverseSegment A t := by
