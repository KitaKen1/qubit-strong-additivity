      ∑ i ∈ Finset.univ.erase i₀, (Real.log (A.H.eigenvalues i+1)+1) := by
  let q : k → ℝ := fun i => ((A.H.eigenvalues i+t)*Real.log (A.H.eigenvalues i+t)-
    A.H.eigenvalues i*Real.log (A.H.eigenvalues i))/t
