    (hJ : J.mat.PosDef) (hl₀ : lambda₀ < 0) (hl₁ : lambda₁ < 0) :
    ∃! W : Blocks r s, W ∈ positiveCone ∧ IsMinOn (objective J lambda₀ lambda₁) positiveCone W := by
