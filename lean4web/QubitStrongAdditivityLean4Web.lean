  rw [operatorCoordinateCLM_apply,pw_mulVec,coordinates_mul,coordinates_mul,
    coordinates_power,coordinates_power,Matrix.mul_diagonal,Matrix.diagonal_mul]
  simp only [Complex.ofReal_mul]
