-- The Mathlib-only statements, written out without the proof-side vocabulary.
open QubitHolevo in
example {r s n m : ℕ}
    (K : Fin r → Matrix (Fin 2) (Fin 2) ℂ) (hK : IsKraus K)
    (L : Fin s → Matrix (Fin (m + 1)) (Fin (n + 1)) ℂ) (hL : IsKraus L) :
    holevo (tensorKraus K L) = holevo K + holevo L :=
  QubitHolevo.strong_additivity K hK L hL
open QubitHolevo in
example {r : ℕ} (K : Fin r → Matrix (Fin 2) (Fin 2) ℂ) (hK : IsKraus K) (n : ℕ) :
    holevo (powerKraus K n) = n * holevo K :=
  QubitHolevo.power_additivity K hK n
