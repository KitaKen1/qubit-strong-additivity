def QubitAdditivity.GeneralQubitStrongAdditivity : Prop :=
∀ (Φ : CPTPMap (Fin 2) (Fin 2) ℂ) (n m : ℕ) (Ω : CPTPMap (Fin (n + 1)) (Fin (m + 1)) ℂ),
  QubitAdditivity.holevo (Φ⊗ᶜᵖΩ) = QubitAdditivity.holevo Φ + QubitAdditivity.holevo Ω
def QubitAdditivity.GeneralQubitUpperBound : Prop :=
∀ (Φ : CPTPMap (Fin 2) (Fin 2) ℂ) (n m : ℕ) (Ω : CPTPMap (Fin (n + 1)) (Fin (m + 1)) ℂ),
  QubitAdditivity.holevo (Φ⊗ᶜᵖΩ) ≤ QubitAdditivity.holevo Φ + QubitAdditivity.holevo Ω
def QubitAdditivity.TC4Bound : Prop :=
∀ {R S Kc L T : Type} [inst : Fintype R] [inst_1 : DecidableEq R] [inst_2 : Fintype S] [inst_3 : DecidableEq S]
  [inst_4 : Fintype Kc] [inst_5 : Fintype L] [inst_6 : Fintype T] (A : Matrix R Kc ℂ) (B : Matrix R L ℂ)
  (C : Matrix S Kc ℂ) (D : Matrix S T ℂ),
  QubitAdditivity.blockMass A + QubitAdditivity.blockMass B + QubitAdditivity.blockMass C +
        QubitAdditivity.blockMass D =
      1 →
    QubitAdditivity.OpenAIEntropy.entropy
                (QubitAdditivity.tc4ScalarMatrix (QubitAdditivity.blockMass A) (QubitAdditivity.blockMass B)
                  (QubitAdditivity.blockMass C) (QubitAdditivity.blockMass D)) +
              QubitAdditivity.weightedBlockEntropy A +
            QubitAdditivity.weightedBlockEntropy B +
          QubitAdditivity.weightedBlockEntropy C +
        QubitAdditivity.weightedBlockEntropy D ≤
      QubitAdditivity.OpenAIEntropy.entropy
        (QubitAdditivity.tc4Matrix A B C D * (QubitAdditivity.tc4Matrix A B C D).conjTranspose)
def QubitAdditivity.QubitPureInputBound : Prop :=
∀ (Φ : CPTPMap (Fin 2) (Fin 2) ℂ) (n m : ℕ) (Ω : CPTPMap (Fin (n + 1)) (Fin (m + 1)) ℂ),
  QubitAdditivity.PureInputBound Φ Ω
